# Скопируйте в .env, если нужно переопределить настройки.
# Ключ API лежит отдельно в api_key.txt.

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY_FILE=api_key.txt
PORT=8086
MCP_NODE=C:\Program Files\nodejs\node.exe
MCP_NPX_CLI=C:\Program Files\nodejs\node_modules\npm\bin\npx-cli.js
MCP_SERVER=filesystem
MCP_ALLOWED_DIR=data/mcp-demo
